# JTech Tally Bridge - .env for production deployment
# Copy to .env.prod and fill in real values before running docker-compose.

# --- TallyPrime connection ---
TALLY_PROFILE=manual
TALLY_HOST=192.168.1.10
TALLY_PORT=9000
TALLY_TIMEOUT=60

# --- Storage ---
DATABASE_PATH=data/jtech_tally_bridge.sqlite3
OUTPUT_DIR=data
EXPORTS_DIR=data/exports

# --- Application ---
DEBUG=False
LOG_LEVEL=INFO
LOG_FILE=data/jtech_tally_bridge.log

# --- Django (CRITICAL - change in production) ---
# Generate with: python -c "from secrets import token_urlsafe; print(token_urlsafe(50))"
DJANGO_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_KEY
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tally.example.com,api.tally.example.com

# --- Gunicorn ---
GUNICORN_WORKERS=5
GUNICORN_THREADS=2
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info
