# --- TallyPrime connection ---
# auto | localhost | manual
TALLY_PROFILE=auto

# Used only when TALLY_PROFILE=manual, otherwise 'auto' triggers detection
TALLY_HOST=auto
TALLY_PORT=9000
TALLY_TIMEOUT=60

# --- Storage ---
DATABASE_PATH=data/jtech_tally_bridge.sqlite3
OUTPUT_DIR=data
EXPORTS_DIR=data/exports

# --- Application ---
DEBUG=False
LOG_LEVEL=INFO
LOG_FILE=data/jtech_tally_bridge.log

# --- Django (Phase 5) ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
